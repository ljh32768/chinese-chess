{
  "name": "lan-chess",
  "version": "0.1.0",
  "private": true,
  "description": "局域网两人中国象棋 MVP（主机权威 + WebSocket + 纯 TS 规则引擎）",
  "type": "module",
  "main": "dist/main/main.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-assets.mjs",
    "dev": "node scripts/dev.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "serve": "node dist/server/server-main.js",
    "host": "node dist/server/server-main.js",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win"
  },
  "build": {
    "appId": "com.lanchess.app",
    "productName": "LanChess",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "Reference/Pikafish皮卡鱼20260925/Pikafish-Windows-x86-64-universal.exe",
        "to": "dist/engine/Pikafish-Windows-x86-64-universal.exe"
      },
      {
        "from": "Reference/Pikafish皮卡鱼20260925/pikafish.nnue",
        "to": "dist/engine/pikafish.nnue"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "局域网象棋"
    }
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.7.0",
    "@types/ws": "^8.5.12",
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.71.0",
    "vitest": "^2.1.0"
  }
}
